{
  "name": "shunji-anime-watch-list-rankings",
  "version": "1.0.0",
  "description": "A React and Firebase prototype for shared anime rankings, personal watchlists, soundtrack entries, and themed scene viewing.",
  "author": "SHLEW06",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "build": "vite build",
    "dev": "vite",
    "preview": "vite preview",
    "lint": "eslint .",
    "test:rules": "firebase emulators:exec --only firestore --project demo-anime-watchlist \"node --test tests/firestore.rules.test.js\"",
    "deploy": "npm run build && firebase deploy"
  },
  "dependencies": {
    "firebase": "^10.6.0",
    "framer-motion": "^12.38.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@firebase/rules-unit-testing": "^3.0.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "firebase-tools": "^15.13.0",
    "globals": "^17.4.0",
    "vite": "^8.0.4"
  }
}
